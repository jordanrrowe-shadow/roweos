{
  "name": "brilliance",
  "version": "33.2.0",
  "private": true,
  "description": "Brilliance — Intelligence OS by RoweOS. Modular source builds to RoweOS/dist/index.html.",
  "scripts": {
    "build": "bash src/build.sh",
    "build:bundle": "node --import tsx build.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:critical": "vitest run --include='src/__tests__/critical/**'",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not yet wired'",
    "deploy": "./deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0",
    "jsdom": "^28.0.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
